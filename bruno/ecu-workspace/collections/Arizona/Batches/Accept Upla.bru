meta {
  name: Accept Upla
  type: http
  seq: 2
}

post {
  url: {{server}}/policy/api/v1/arizona/ensurance_upla/batch_approval_check
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  User-Agent: insomnia/2023.5.8
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
  	"_type": "BatchUplaValidationRequest",
  	"params": {
  		"productList": "VH"	
  	}
  }
}

settings {
  encodeUrl: true
  followRedirects: true
}
