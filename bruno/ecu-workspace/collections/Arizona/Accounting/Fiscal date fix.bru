meta {
  name: Fiscal date fix
  type: http
  seq: 1
}

post {
  url: {{ server }}:{{ serverPort }}/accounting/api/v1/arizona/fiscal_years/next_year
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  x-tenantId-1: ec
}

auth:bearer {
  token: {% response 'body', 'req_495458d277de45a59e708c935a15d271', 'b64::JC5ib2R5LmFjY2Vzc1Rva2Vu::46b', 'always', 60 %}
}

body:json {
  {
  "_type": "FiscalYear",
  "fiscalCalendarName": "LOCAL"
  }
  
  //Musi mieć role: Modify_fiscal_calendar_role, Modify_fiscal_year_role
}

settings {
  encodeUrl: true
  followRedirects: true
}
