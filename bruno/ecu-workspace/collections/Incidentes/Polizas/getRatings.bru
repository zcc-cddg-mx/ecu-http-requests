meta {
  name: getRatings
  type: http
  seq: 12
}

post {
  url: {{server}}/rule/api/v1/arizona/lookup_ratings/list
  body: json
  auth: bearer
}

headers {
  x-tenantid-1: ec
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "_type": "LookupRatingRequest",
      "ratingListName": "INSURANCE_MATRIX",
      "fieldName": "assetType",
      "params": {
          "productType": "7"
      }
  }
}

settings {
  encodeUrl: true
}
