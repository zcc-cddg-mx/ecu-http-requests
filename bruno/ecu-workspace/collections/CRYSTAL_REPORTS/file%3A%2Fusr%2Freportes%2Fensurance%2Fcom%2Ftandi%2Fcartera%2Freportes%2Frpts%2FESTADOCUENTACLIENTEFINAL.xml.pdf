<script language="JavaScript">
function toggleDetails(){
	var details = document.getElementById('details').style;
	if(details.display=='block'){
		details.display='none';
		document.getElementById('plus').style.display='inline';
		document.getElementById('minus').style.display='none';
	}else{
		details.display="block";
		document.getElementById('plus').style.display='none';
		document.getElementById('minus').style.display='inline';
	}
}

function submitForm(){
	var send = confirm('Do you agree to send the error details to www.inetsoftware.de?');
	if(send)
		document.getElementById('errorform').submit();
}
</script>
