      "testMode": false,
      "motorGenericosTarification": {
          "_type": "MotorGenericosTarification",
          "policyData": {
              "_type": "PolicyData",
              "variant": "MOTOR",
              "consents": [],
              "ensuranceDocuments": [],
              "endorsementIds": [],
              "uplaUpdate": "NO",
              "paymentMethodAllowed": [],
              "policyEndorsementIds": [],
              "policyAgencies": [],
              "nextInsurableObjectAllowed": "NO",
              "entityProperties": {}
          },
          "beneficiaries": [],
          "cars": [],
          "planInformation": []
      }
  }
}

settings {
  encodeUrl: true
}
